{
  "name": "playwright-cucumber-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API test automation with Cucumber",
  "scripts": {
    "test": "mkdir -p reports && cucumber-js",
    "test:ui": "mkdir -p reports && cucumber-js --tags @ui",
    "test:api": "mkdir -p reports && cucumber-js --tags @api",
    "report": "node utils/generateCucumberReport.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "multiple-cucumber-html-reporter": "^4.4.2",
    "playwright": "^1.49.1"
  }
}